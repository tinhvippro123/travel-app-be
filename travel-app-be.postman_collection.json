{
  "info": {
    "name": "Travel App API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"Test User\",\n  \"phone\": \"0123456789\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Place",
      "item": [
        {
          "name": "Get All Places",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/places",
              "host": ["{{baseUrl}}"],
              "path": ["places"]
            }
          }
        },
        {
          "name": "Search Places By Location",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/places/search?location=Da Nang",
              "host": ["{{baseUrl}}"],
              "path": ["places", "search"],
              "query": [
                { "key": "location", "value": "Da Nang" }
              ]
            }
          }
        },
        {
          "name": "Get Places By Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/places/status/active",
              "host": ["{{baseUrl}}"],
              "path": ["places", "status", "active"]
            }
          }
        },
        {
          "name": "Get Place By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/places/{{placeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["places", "{{placeId}}"]
            }
          }
        },
        {
          "name": "Create Place",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Da Nang\",\n  \"description\": \"Coastal city in Central Vietnam.\",\n  \"location\": \"Da Nang\",\n  \"image\": \"https://example.com/da-nang.jpg\",\n  \"content\": \"<p>Da Nang is known for beaches, bridges, and nearby heritage sites.</p>\",\n  \"status\": \"active\",\n  \"categoryIds\": [\"{{placeCategoryId}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/places",
              "host": ["{{baseUrl}}"],
              "path": ["places"]
            }
          }
        },
        {
          "name": "Update Place",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Da Nang City\",\n  \"description\": \"Updated place description.\",\n  \"location\": \"Da Nang\",\n  \"image\": \"https://example.com/da-nang-updated.jpg\",\n  \"content\": \"<p>Updated rich content for Da Nang.</p>\",\n  \"status\": \"active\",\n  \"categoryIds\": [\"{{placeCategoryId}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/places/{{placeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["places", "{{placeId}}"]
            }
          }
        },
        {
          "name": "Update Place Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"inactive\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/places/{{placeId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["places", "{{placeId}}", "status"]
            }
          }
        },
        {
          "name": "Delete Place",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/places/{{placeId}}",
              "host": ["{{baseUrl}}"],
              "path": ["places", "{{placeId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Place Category",
      "item": [
        {
          "name": "Get All Place Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/place-categories",
              "host": ["{{baseUrl}}"],
              "path": ["place-categories"]
            }
          }
        },
        {
          "name": "Get Place Category By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/place-categories/{{placeCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["place-categories", "{{placeCategoryId}}"]
            }
          }
        },
        {
          "name": "Create Place Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Beach\",\n  \"thumbnailUrl\": \"https://example.com/beach.jpg\",\n  \"description\": \"Coastal destinations, beaches, islands, and bays.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/place-categories",
              "host": ["{{baseUrl}}"],
              "path": ["place-categories"]
            }
          }
        },
        {
          "name": "Update Place Category",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Beach & Islands\",\n  \"thumbnailUrl\": \"https://example.com/beach-islands.jpg\",\n  \"description\": \"Updated category description.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/place-categories/{{placeCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["place-categories", "{{placeCategoryId}}"]
            }
          }
        },
        {
          "name": "Delete Place Category",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/place-categories/{{placeCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["place-categories", "{{placeCategoryId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Booking",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"placeId\": \"uuid-here\",\n  \"numberOfParticipants\": 2,\n  \"contactPhone\": \"0123456789\",\n  \"contactEmail\": \"test@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": "your_jwt_token_here"
    },
    {
      "key": "placeId",
      "value": "place_uuid_here"
    },
    {
      "key": "placeCategoryId",
      "value": "place_category_uuid_here"
    }
  ]
}
